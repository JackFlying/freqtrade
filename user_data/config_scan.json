{
    // JSON Schema 地址：供 IDE 校验配置格式并提供参数提示。
    "$schema": "https://schema.freqtrade.io/schema.json",

    // 机器人名称：用于日志、FreqUI 和 API 中识别当前实例，不影响交易逻辑。
    "bot_name": "binance-spot-scanner",

    // 使用的策略类名称，对应 SpotScanStrategy.py 中的 SpotScanStrategy。
    "strategy": "SpotScanStrategy",

    // K 线周期：候选列表更新后，最迟在下一根 15 分钟 K 线检查直接买入信号。
    "timeframe": "15m",

    // 最大同时持有的交易数：当前最多允许 1 笔未结束的交易。
    "max_open_trades": 1,

    // 仓位计价货币：使用 USDT 买入其他币种。
    "stake_currency": "USDT",

    // 单笔交易投入金额：unlimited 表示使用当前可用余额。
    "stake_amount": "unlimited",

    // 当剩余余额不足一个完整 stake_amount 时，允许最后一笔使用剩余余额开仓。
    "amend_last_stake_amount": true,

    // 最后一笔开仓的最低比例：剩余金额至少达到目标仓位的 10% 才允许开仓。
    "last_stake_amount_min_ratio": 0.1,

    // 允许用于交易的余额比例：最多使用总余额的 99%，预留 1% 作为缓冲。
    // 实际资金占用仍会受到 stake_amount 和 max_open_trades 限制。
    "tradable_balance_ratio": 1.00,

    // 模拟交易开关：true 表示不向交易所提交真实订单。
    "dry_run": true,

    // 模拟交易的初始钱包余额，仅在 dry_run=true 时生效。
    "dry_run_wallet": 1000,

    // 交易模式：spot 表示现货交易。
    "trading_mode": "spot",

    // 保证金模式：现货交易不使用保证金，因此留空。
    "margin_mode": "",

    // 机器人停止时是否撤销未成交订单：false 表示不因程序退出自动撤单。
    "cancel_open_orders_on_exit": false,

    // 入场和出场限价单的未成交超时设置。
    "unfilledtimeout": {
        // 入场订单超过 10 分钟未成交时执行超时处理。
        "entry": 10,

        // 出场订单超过 10 分钟未成交时执行超时处理。
        "exit": 10,

        // 出场订单允许的超时次数；0 表示不限制超时重试次数。
        "exit_timeout_count": 0,

        // entry 和 exit 超时值的时间单位。
        "unit": "minutes"
    },

    // 入场订单的价格计算方式。
    "entry_pricing": {
        // 市价买入使用卖方一侧报价，满足 Freqtrade 的市价单校验要求。
        "price_side": "other",

        // 使用订单簿报价，而不是仅使用最新成交价。
        "use_order_book": true,

        // 使用订单簿第 1 档价格。
        "order_book_top": 1,

        // 订单簿价格与最新成交价之间的平衡系数；0.0 表示优先使用订单簿同侧价格。
        "price_last_balance": 0.0,

        // 下单前是否检查订单簿买卖盘深度。
        "check_depth_of_market": {
            // false 表示关闭买卖盘深度过滤。
            "enabled": false,

            // 启用深度检查时要求的买盘与卖盘比例阈值；当前因 enabled=false 而不生效。
            "bids_to_ask_delta": 1
        }
    },

    // 出场订单的价格计算方式。
    "exit_pricing": {
        // 市价卖出使用交易方向对手侧报价，满足 Freqtrade 的市价单校验要求。
        "price_side": "other",

        // 使用订单簿报价，而不是仅使用最新成交价。
        "use_order_book": true,

        // 使用订单簿第 1 档价格。
        "order_book_top": 1
    },

    // 交易所连接及交易对范围设置。
    "exchange": {
        // 交易所名称：Binance。
        "name": "binance",

        // Binance API Key；真实值由 config_private.json 覆盖。
        "key": "REPLACE_WITH_BINANCE_API_KEY",

        // Binance API Secret；真实值由 config_private.json 覆盖。
        "secret": "REPLACE_WITH_BINANCE_API_SECRET",

        // 单核服务器使用 REST 拉取 K 线，避免大量 WebSocket 长连接争抢资源。
        "enable_ws": false,

        // CCXT 同步客户端配置。
        "ccxt_config": {
            // 启用 CCXT 请求频率限制，降低触发交易所限流的风险。
            "enableRateLimit": true,

            // 自定义 Binance API 地址。
            "urls": {
                // API 类型及其对应地址。
                "api": {
                    // Binance 公开市场数据 API v3 地址。
                    "public": "https://data-api.binance.vision/api/v3",

                    // Binance 公开市场数据 API v1 地址。
                    "v1": "https://data-api.binance.vision/api/v1"
                }
            },

            // 传递给 CCXT 的附加选项。
            "options": {
                // 默认只加载和使用现货市场。
                "defaultType": "spot",

                // 获取市场列表时的过滤设置。
                "fetchMarkets": {
                    // 只获取现货类型的市场。
                    "types": [
                        "spot"
                    ]
                }
            }
        },

        // CCXT 异步客户端配置，用于并发获取行情等异步请求。
        "ccxt_async_config": {
            // 启用 CCXT 请求频率限制，降低触发交易所限流的风险。
            "enableRateLimit": true,

            // 自定义 Binance API 地址。
            "urls": {
                // API 类型及其对应地址。
                "api": {
                    // Binance 公开市场数据 API v3 地址。
                    "public": "https://data-api.binance.vision/api/v3",

                    // Binance 公开市场数据 API v1 地址。
                    "v1": "https://data-api.binance.vision/api/v1"
                }
            },

            // 传递给 CCXT 异步客户端的附加选项。
            "options": {
                // 默认只加载和使用现货市场。
                "defaultType": "spot",

                // 获取市场列表时的过滤设置。
                "fetchMarkets": {
                    // 只获取现货类型的市场。
                    "types": [
                        "spot"
                    ]
                }
            }
        },

        // 交易对白名单：正则表达式匹配所有以 USDT 计价的交易对。
        "pair_whitelist": [
            ".*/USDT"
        ],

        // 交易对黑名单：即使匹配白名单，也会排除以下交易对。
        "pair_blacklist": [
            // 排除名称以 UP、DOWN、BULL、BEAR 结尾的杠杆代币。
            ".*(UP|DOWN|BULL|BEAR)/USDT",
            ".*([2-5]L|[2-5]S)/USDT",

            // 排除稳定币及部分法币与 USDT 之间的交易对。
            "(USDC|FDUSD|TUSD|USDP|DAI|EUR|TRY|BRL)/USDT"
        ]
    },

    // 交易对列表生成方式。
    "pairlists": [
        {
            // 先按 24h 成交额建立轻量交易池，最终买入仍由独立候选 CSV 决定。
            "method": "VolumePairList",
            "number_assets": 500,
            "sort_key": "quoteVolume",
            "min_value": 1000000,
            "refresh_period": 3600
        }
    ],

    // Telegram 通知和机器人控制设置。
    "telegram": {
        // 是否启用 Telegram；true 表示开启（token/chat_id 由服务器环境变量注入）。
        "enabled": true,

        // Telegram Bot Token；未启用时留空。
        "token": "",

        // 接收通知的 Telegram Chat ID；未启用时留空。
        "chat_id": ""
    },

    // Freqtrade REST API、WebSocket 和 FreqUI 后端设置。
    "api_server": {
        // 启用 API 服务，以便 FreqUI 和 API 客户端连接。
        "enabled": true,

        // 只监听本机回环地址，局域网或公网设备无法直接访问。
        "listen_ip_address": "127.0.0.1",

        // API 服务监听端口。
        "listen_port": 8081,

        // API 日志级别：只记录错误级别的信息。
        "verbosity": "error",

        // 是否开放 OpenAPI/Swagger 接口文档。
        "enable_openapi": false,

        // JWT 签名密钥；真实值由 config_private.json 覆盖。
        "jwt_secret_key": "REPLACE_WITH_A_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS",

        // WebSocket 连接令牌；真实值由 config_private.json 覆盖。
        "ws_token": "REPLACE_WITH_A_RANDOM_WEBSOCKET_TOKEN",

        // 允许跨域访问 API 的来源列表；空数组表示不额外允许跨域来源。
        "CORS_origins": [],

        // FreqUI 和 REST API 登录用户名；真实值由 config_private.json 覆盖。
        "username": "REPLACE_WITH_PRIVATE_USERNAME",

        // FreqUI 和 REST API 登录密码；真实值由 config_private.json 覆盖。
        "password": "REPLACE_WITH_A_STRONG_DASHBOARD_PASSWORD"
    },

    // 程序启动后的机器人状态：running 表示重启后自动恢复交易和持仓管理。
    "initial_state": "running",

    // 是否允许通过 API 或 FreqUI 手动强制入场；false 用于防止误操作。
    "force_entry_enable": false,

    // Freqtrade 内部运行参数。
    "internals": {
        // 主处理循环的最短间隔，单位为秒。
        "process_throttle_secs": 5
    },

    // 当前项目自定义的市场扫描器参数。
    "scanner": {
        // 每个交易对获取的 K 线数量。
        "candle_limit": 250,

        // 同时执行行情扫描任务的最大并发数。
        "concurrency": 6,

        // 最低计价货币成交量过滤值；0 表示不按成交额设置最低门槛。
        "minimum_quote_volume": 0,

        // 每次扫描最多保留或输出的结果数量。
        "maximum_results": 100,

        // 扫描结果文件的输出目录。
        "output_directory": "user_data/scan_results",

        // 独立的日线趋势筛选器，仅用于展示，不参与交易机器人下单。
        "daily_trend": {
            // 进入观察范围所需的最低 24 小时 USDT 成交额。
            "minimum_quote_volume": 1000000,

            // 至少需要 60 根已收盘日线；不足 99 根时使用临时 MA99。
            "minimum_listing_days": 60,

            // 成交额交易池每 1 小时扫描全量市场并重新筛选一次。
            "universe_refresh_seconds": 3600,

            // 未收盘日线和 MA 每 15 分钟更新一次。
            "update_interval_seconds": 900,

            // 本地保留约一年的日线，为 MA99 提供充足历史数据。
            "history_candle_limit": 365,

            // 同时更新日线数据的最大请求数。
            "concurrency": 6,

            // 独立日线缓存目录，其中包含每 15 分钟更新的未收盘日线。
            "cache_directory": "user_data/scan_data/daily_trend",

            // 日线趋势筛选结果输出目录。
            "output_directory": "user_data/scan_results",

            // 额外排除的稳定币基础资产，不影响交易机器人的原有白名单。
            "stablecoin_bases": [
                "AEUR",
                "BUSD",
                "DAI",
                "EURI",
                "FDUSD",
                "FRAX",
                "RLUSD",
                "TUSD",
                "USDC",
                "USDD",
                "USDE",
                "USDP",
                "USDS",
                "USD1",
                "USTC",
                "XUSD"
            ],

            // 交易所风险标记文件；记录下架预警、Monitoring Tag 等人工确认事件。
            "risk_flags_file": "user_data/scan_data/daily_trend/risk_flags.json",

            // 只使用最近 30 天内的风险标记，过期标记自动失效。
            "risk_flag_lookback_days": 30,

            // 成交额异常过滤：高成交额、反复极端放量且价格波动极低时排除。
            "wash_trading_filter_enabled": true,
            "wash_trading_volume_spike_ratio": 12.0,
            "wash_trading_min_suspicious_days": 3,
            "wash_trading_max_range_pct": 0.6,
            "wash_trading_min_daily_quote_volume": 10000000
        }
    }
}
